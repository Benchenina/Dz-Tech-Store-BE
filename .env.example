# ---------------------------------------------------------------------------
# ENSTA WAMD TD-TP 3 - E-Commerce API configuration
# Copy this file to .env and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ensta_wamd_tp3

# Authentication - generate with: openssl rand -hex 48
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=ensta-wamd-tp3
JWT_AUDIENCE=ensta-wamd-dashboard

# Password hashing
BCRYPT_SALT_ROUNDS=12

# CORS - comma separated list of allowed browser origins
CLIENT_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (milliseconds / requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Data seeding
AUTO_SEED=true

# Development convenience: allows the dashboard and test-api.sh to reset
# in-memory counters after demonstrating 429 responses. Never used in production.
DEV_RATE_LIMIT_RESET=true

# ---------------------------------------------------------------------------
# OAuth2 / OpenID Connect bearer-token support
# ---------------------------------------------------------------------------
OAUTH2_ENABLED=true

# Mock tokens are intended for local TP demonstrations only.
OAUTH2_MOCK_ENABLED=true
OAUTH2_ALLOW_MOCK_IN_PRODUCTION=false
# JSON map of token -> claims. Pair syntax "token=email,token2=email2" also works.
OAUTH2_MOCK_TOKENS={"ensta-demo-oauth-token":{"sub":"oauth-demo-user","name":"OAuth Demo User","email":"oauth.demo@ensta.dz"}}

# Optional OpenID Connect UserInfo endpoint used to validate opaque tokens.
# Example: https://accounts.example.com/oidc/userinfo
OAUTH2_USERINFO_URL=
OAUTH2_TIMEOUT_MS=5000
